[Unit]
Description=Ubuntu Security Audit
Documentation=https://github.com/secopsxsaiyan/ubuntu-sec-audit
# Started by ubuntu-sec-audit.timer; the service itself has no [Install]
# section, so enabling it cannot start an audit at every boot.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=REPORT_DIR=/var/log/ubuntu-sec-audit
# For --webhook, keep the URL out of this world-readable file: put
# AUDIT_WEBHOOK_URL=https://... in a root-only file and uncomment:
#EnvironmentFile=/etc/ubuntu-sec-audit/webhook.env

ExecStartPre=/bin/mkdir -p ${REPORT_DIR}
ExecStartPre=/bin/chmod 700 ${REPORT_DIR}

# Standard mode with OSCAL output. The script prints its own comparison with
# the previous run (delta report) to the journal.
# systemd does not expand variables in the program path: if you cloned the
# repository elsewhere, change /opt/ubuntu-sec-audit below.
ExecStart=/opt/ubuntu-sec-audit/ubuntu-sec-audit.sh \
    --oscal \
    --catalog nist \
    --skip-apt-update \
    --output-dir ${REPORT_DIR}

# Run as root (required for sysctl, ss, auditctl, etc.)
User=root

# Capture all output to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ubuntu-sec-audit

# Resource limits — prevent the audit from starving production workloads.
# No sandboxing on purpose: ProtectHome would hide /home from the secrets and
# home-permission checks, PrivateTmp would change what the /tmp mount check
# sees, and ProtectSystem would hide the configuration being audited.
CPUQuota=50%
MemoryMax=512M
IOSchedulingClass=idle
Nice=10
